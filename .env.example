# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Encrypts the CreatorBoost OAuth session cookie.
# Use a long random value in production.
SESSION_SECRET=replace_with_a_long_random_secret

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_customer_id
GOOGLE_ADS_LANGUAGE_ID=1000
GOOGLE_ADS_GEO_TARGET_ID=2840
GOOGLE_ADS_API_VERSION=v25

# Optional: display-only customer ID used by the browser UI.
# Do not put secrets here.
NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID=
